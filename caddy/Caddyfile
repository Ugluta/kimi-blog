{
servers {
trusted_proxies static private_ranges
}
}

{$DOMAIN:localhost} {
reverse_proxy web:80
header {
-Server
-X-Powered-By
Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
X-Content-Type-Options "nosniff"
X-Frame-Options "SAMEORIGIN"
Referrer-Policy "strict-origin-when-cross-origin"
Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; connect-src 'self' https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; media-src 'self' https: blob:; img-src 'self' data: https:"
}
encode zstd gzip
}

api.{$DOMAIN:localhost} {
reverse_proxy api:3000
header {
-Server
X-Content-Type-Options "nosniff"
}
encode zstd gzip
}

media.{$DOMAIN:localhost} {
reverse_proxy minio:9000
encode zstd gzip
header {
Access-Control-Allow-Origin "*"
Cache-Control "public, max-age=86400"
}
}

grafana.{$DOMAIN:localhost} {
reverse_proxy grafana:3000
}
